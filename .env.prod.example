# Copie para .env.prod (nao versione) e preencha.

# Dominio (registro A apontando para o IP fixo), sem https://
DOMINIO=chatbot.exemplo.com.br

# Senhas: use valores longos e unicos
POSTGRES_PASSWORD=troque-esta-senha
JWT_SEGREDO=troque-por-um-texto-aleatorio-longo
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Atendente PROCON

# Opcional (padroes abaixo): Ollama rodando no proprio PC
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_KEEP_ALIVE=60m
